<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-OpencodeRemote-5fcb6e0b-6398-4cc6-aac7-9582bd75a7c1</UserSecretsId>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>opencode-remote</ToolCommandName>
    <PackageId>OpenCodeRemote</PackageId>
    <Version>0.2.2</Version>
    <Authors>OpenCode Remote contributors</Authors>
    <Description>Run and monitor local OpenCode sessions through Telegram.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ianfelps/opencode-remote</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpencodeRemote.Tests" />
  </ItemGroup>
</Project>
